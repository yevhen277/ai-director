YOLO_MODEL=models/yolov8n.pt
YOLO_CONFIDENCE=0.2

FACE_MODEL=buffalo_l
FACE_THRESHOLD=0.45
FACE_REGISTRY_PATH=data/face_registry.json

# 默认摄像头来源：
# - 普通本机/USB 摄像头：opencv
# - Orbbec 摄像头：orbbec
DEFAULT_CAMERA_SOURCE=opencv
# 摄像头序号通常从 0 开始；如果有多个摄像头，可尝试 1、2、3...
DEFAULT_CAMERA_INDEX=0

CAMERA_RUN_MAX_SAVED_IMAGES=100

TCP_FACE_ENABLED=false
TCP_FACE_HOST=192.168.1.101
TCP_FACE_PORT=9000
TCP_FACE_IDENTITY=zhangzhan
TCP_FACE_TIMEOUT_SECONDS=0.2
TCP_FACE_SEND_FPS=10
TCP_FACE_TRACK_TTL_SECONDS=1.0

DIRECTOR_PLAN_MODE=llm
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=45
